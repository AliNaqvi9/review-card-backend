# Copy this file to .env and fill in real values. Never commit .env.

# Port the Node process listens on (Caddy will proxy to this)
PORT=3000

# Set to "development" for localhost testing. Use "production" only on the real server.
NODE_ENV=development

# Long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Bcrypt hash of your admin password - never store the plain password.
# Generate with: npm run hash-password -- "your-chosen-password"
ADMIN_PASSWORD_HASH=

# Where the SQLite file lives. Defaults to ./data/cards.db if omitted.
DB_PATH=./data/cards.db
