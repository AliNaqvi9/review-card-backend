# Copy to /etc/systemd/system/review-cards.service, then edit the two
# paths below and the User= line to match your server.
#
#   sudo cp deploy/review-cards.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now review-cards
#   sudo systemctl status review-cards      # check it's running
#   journalctl -u review-cards -f           # tail logs

[Unit]
Description=Review card redirect backend
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/review-card-backend
ExecStart=/usr/bin/node app.js
EnvironmentFile=/home/ubuntu/review-card-backend/.env
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
